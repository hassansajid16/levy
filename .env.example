# Copy this file to .env and fill in your Plaid keys to connect real (or sandbox) banks.
# Free sandbox keys: https://dashboard.plaid.com/developers/keys
# Never commit .env: it is in .gitignore.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (test banks and fake data) or production (real banks; needs Plaid approval)
PLAID_ENV=sandbox
# Only needed for OAuth banks (most UK and EU banks). Register the same URI in the Plaid dashboard.
PLAID_REDIRECT_URI=

# Hosting (optional). Leave these out to run only on this computer.
# HOST=0.0.0.0              (not needed on Render or Railway)
# PUBLIC_ORIGIN=https://your-levy-address.example.com
